code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_9;
uniform sampler2D tex_frg_10;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// UVFunc:7
	vec2 n_in7p1 = vec2(3.00000, 3.00000);
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (UV - n_in7p2) * n_in7p1 + n_in7p2;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out7p0);


// Mix:5
	float n_in5p2 = 0.70000;
	float n_out5p0 = mix(n_out2p0.x, n_out3p0.x, n_in5p2);


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, n_out7p0);


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);


// Mix:8
	vec4 n_out8p0 = mix(vec4(n_out5p0), n_out9p0, n_out10p0);


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);


}
